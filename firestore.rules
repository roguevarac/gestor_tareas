rules_version = '2';

// Reglas de Mis tareas (modo equipo).
// Cada navegador entra como "anónimo", elige quién es de la lista del equipo y pone su contraseña.
// Solo quien administra (con su clave) puede sumar o sacar gente.
// Publicar con: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function claimPath() { return /databases/$(database)/documents/claims/$(request.auth.uid); }
    // Persona del equipo que eligió este navegador.
    function me() { return get(claimPath()).data.memberId; }
    function isMember() {
      return signedIn() && exists(claimPath())
        && (exists(/databases/$(database)/documents/members/$(me()))
          || exists(/databases/$(database)/documents/privateMembers/$(me())));
    }
    // Acceso privado (por ejemplo, finanzas): no figura en el equipo y nadie ve sus tareas.
    function isPrivate(id) { return exists(/databases/$(database)/documents/privateMembers/$(id)); }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Ve el tablero del equipo y usa la caña.
    function isSupervisor() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(me())).data.get('supervisor', false) == true;
    }
    function isAdminAfter() {
      return signedIn() && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // "Ya hay equipo": lo puede leer cualquiera; se crea una sola vez, al armarlo.
    match /config/public {
      allow get: if signedIn();
      allow create: if isAdminAfter()
        && !exists(/databases/$(database)/documents/config/public);
    }

    // La clave para administrar: nadie la puede leer.
    match /config/secrets {
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/config/public)
        && request.resource.data.keys().hasOnly(['adminCode'])
        && request.resource.data.adminCode is string
        && request.resource.data.adminCode.size() >= 6;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['adminCode'])
        && request.resource.data.adminCode is string
        && request.resource.data.adminCode.size() >= 6;
    }

    // Navegadores que administran (entraron con la clave).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code == getAfter(/databases/$(database)/documents/config/secrets).data.adminCode;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // El equipo: lo ve cualquiera que abre la app (para elegir quién es); lo cambia quien administra.
    match /members/{id} {
      allow read: if signedIn();
      // Cada uno solo puede marcar que ya cambió la contraseña que le dieron.
      allow update: if isMember() && me() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
      allow create, update: if isAdminAfter()
        && request.resource.data.keys().hasOnly(
          ['name', 'email', 'createdAt', 'supervisor', 'hasPassword', 'country', 'mustChangePassword'])
        && request.resource.data.get('mustChangePassword', false) is bool
        && request.resource.data.get('country', null) in [null, 'AR', 'CL', 'UY']
        && request.resource.data.get('supervisor', false) is bool
        && request.resource.data.get('hasPassword', false) is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120;
      allow delete: if isAdmin();
    }

    // Personas con acceso privado: solo las ven quien administra y la persona misma.
    match /privateMembers/{id} {
      allow get: if isAdmin() || (isMember() && me() == id);
      allow list: if isAdmin();
      allow update: if isMember() && me() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
      allow create, update: if isAdminAfter()
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'hasPassword', 'mustChangePassword'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120;
      allow delete: if isAdmin();
    }

    // A quién se le puede mandar un pez aunque tenga acceso privado: solo el nombre.
    match /privateContacts/{id} {
      allow read: if isMember();
      allow create, update: if isAdminAfter()
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();
    }

    // Contraseña de cada persona (solo el hash). Nadie la puede leer; la pone quien administra
    // o la cambia la persona misma.
    match /memberSecrets/{id} {
      allow create, update: if (isAdminAfter() || (isMember() && me() == id))
        && request.resource.data.keys().hasOnly(['hash'])
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 64;
      allow delete: if isAdmin();
    }

    // Quién es cada navegador: para entrar como alguien hay que saber su contraseña.
    match /claims/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['memberId', 'hash', 'at'])
        && request.resource.data.memberId is string
        && (existsAfter(/databases/$(database)/documents/members/$(request.resource.data.memberId))
          || existsAfter(/databases/$(database)/documents/privateMembers/$(request.resource.data.memberId)))
        && (
          // una compu que administra el equipo puede entrar como cualquiera (para arreglar contraseñas)
          isAdmin()
          || request.resource.data.hash
            == getAfter(/databases/$(database)/documents/memberSecrets/$(request.resource.data.memberId)).data.hash
        );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Tareas del equipo: cada uno publica lo que tiene en el agua; lo ve todo el equipo.
    // Quien tiene acceso privado no publica nada (y nadie puede publicar por ella).
    match /boards/{memberId} {
      allow read: if isMember() && !isPrivate(me());
      allow create, update: if isMember() && me() == memberId && !isPrivate(memberId)
        && request.resource.data.memberId == memberId;
      allow delete: if (isMember() && me() == memberId) || isAdmin();
    }

    // La caña: "¿En qué andás?". La puede tirar cualquiera del equipo; contesta solo a quien le llegó.
    match /pings/{id} {
      allow read: if isMember() && !isPrivate(me());
      allow create: if isMember()
        && request.resource.data.from == me()
        && !isPrivate(me())
        && !isPrivate(request.resource.data.to)
        && request.resource.data.keys().hasOnly(
          ['from', 'to', 'fromName', 'toName', 'question', 'createdAt', 'answer', 'answeredAt'])
        && request.resource.data.to is string
        && request.resource.data.answer == null;
      allow update: if isMember() && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt'])
        && request.resource.data.answer is string
        && request.resource.data.answer.size() <= 280;
      allow delete: if isMember() && (resource.data.from == me() || resource.data.to == me());
    }

    // Tareas compartidas.
    match /shared/{id} {
      function cur() { return resource.data; }
      function nxt() { return request.resource.data; }
      function changed() { return nxt().diff(cur()).affectedKeys(); }

      allow read: if isMember();

      allow create: if isMember()
        && nxt().from == me()
        && nxt().participants is list
        && nxt().participants.size() >= 2
        && nxt().participants.size() <= 50
        && me() in nxt().participants
        && nxt().invites[me()] == 'owner'
        && nxt().mode in ['assigned', 'joint']
        && nxt().state == 'open'
        && nxt().title is string
        && nxt().title.size() <= 500;

      // Quien la mandó puede cambiar todo, menos de quién es y quiénes participan.
      allow update: if isMember() && cur().from == me()
        && nxt().from == cur().from
        && nxt().participants == cur().participants
        && nxt().invites[me()] == 'owner';

      // Los demás: responden (aceptar / rechazar / salir) y, si aceptaron, trabajan en la tarea.
      allow update: if isMember() && cur().from != me()
        && me() in cur().participants
        && !changed().hasAny(['from', 'participants', 'names', 'mode', 'fish', 'message', 'createdAt'])
        && nxt().invites.diff(cur().invites).affectedKeys().hasOnly([me()])
        && nxt().invites[me()] in ['pending', 'accepted', 'declined', 'left']
        && (
          changed().hasOnly(['invites', 'updatedAt'])
          || (cur().invites[me()] == 'accepted' && nxt().invites[me()] == 'accepted')
        );

      allow delete: if isMember() && cur().from == me();
    }
  }
}
